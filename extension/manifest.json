{
  "manifest_version": 3,
  "name": "TikTok Fix",
  "version": "1.0.0",
  "description": "TikTok Fix for Desktop",
  "content_scripts": [
    {
      "matches": [
        "https://*.tiktok.com/*",
        "https://tiktok.com/*",
        "http://*.tiktok.com/*",
        "http://tiktok.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "http://127.0.0.1:28889/*"
  ]
}